# Select local Elasticsearch (default):
COMPOSE_FILE=compose.yaml
# Elastic Cloud: compose.yaml:compose.elasticsearch-cloud.yaml
# Local + Dash0: compose.yaml:compose.dash0.yaml
# Cloud + Dash0: compose.yaml:compose.elasticsearch-cloud.yaml:compose.dash0.yaml

WEB_PORT=5173
API_PORT=8000
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.2.0
# Used only by the cloud overlay. Never use VITE_ variables for credentials.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
OTEL_SERVICE_NAMESPACE=tabletalk
# Optional: enable the Dash0 exporter with the Compose overlay documented in README.md.
DASH0_ENDPOINT=
DASH0_AUTH_TOKEN=
DASH0_DATASET=default
