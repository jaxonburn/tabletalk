WEB_PORT=5173
API_PORT=8000
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.2.0
OTEL_SERVICE_NAMESPACE=tabletalk
# Optional: require this token for the host view and host API (blank = open locally).
HOST_TOKEN=
# How often (seconds) the API checks whether an auto-match cutoff has passed.
AUTO_MATCH_POLL_SECONDS=10
# Optional AI table notes and personas: none, anthropic, or openai.
# LLM_MODEL is required when a provider is set (e.g. a current Claude Haiku/Sonnet or
# GPT mini model ID from your provider's docs). Attendee answers are sent to the provider.
LLM_PROVIDER=none
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional OpenAI-compatible or proxy base URL.
LLM_BASE_URL=
# For reasoning models (e.g. the GPT-5 family): minimal, low, or medium. Tested: gpt-5.4-mini + low.
LLM_REASONING_EFFORT=
# Optional semantic matching (needs OPENAI_API_KEY): e.g. text-embedding-3-small. Stored as
# 512-dimension vectors in Elasticsearch and blended with BM25.
EMBEDDING_MODEL=
# Optional: enable the Dash0 exporter with the Compose overlay documented in README.md.
DASH0_ENDPOINT=
DASH0_AUTH_TOKEN=
DASH0_DATASET=default
